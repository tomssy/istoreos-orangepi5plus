# Apply these build-only overrides to the official Rockchip release seed.
CONFIG_TARGET_rockchip_armv8_DEVICE_xunlong_orangepi-5-plus=y
# CONFIG_TARGET_MULTI_PROFILE is not set
# CONFIG_TARGET_ALL_PROFILES is not set
# CONFIG_IB is not set
# CONFIG_SDK is not set
CONFIG_CCACHE_DIR="../.ccache"
CONFIG_BUILD_LOG=y
